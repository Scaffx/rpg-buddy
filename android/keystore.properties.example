# Copie este arquivo para "keystore.properties" (mesma pasta, android/) e
# preencha com os dados REAIS do seu keystore de UPLOAD (não a chave de
# assinatura final — desde 2021 o Google Play Sign App Signing gerencia essa
# pra você; você só precisa de uma upload key).
#
# keystore.properties é gitignored — NUNCA commitar credenciais reais aqui.
#
# Gerar um keystore de upload (uma vez só), rodando de dentro de android/:
#   keytool -genkeypair -v -keystore release.jks -alias upload \
#     -keyalg RSA -keysize 2048 -validity 10000
#
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
